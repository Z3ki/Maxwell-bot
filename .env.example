# =============================================================================
# Maxwell — .env template
#
# Copy to .env and fill in TWO values: DISCORD_TOKEN and your model settings.
# Everything below that has a working default or turns itself off when its
# dependency is missing. `./setup.sh` writes this file for you; `python3
# doctor.py` tells you what is on, what is off, and why.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the whole minimum install
# -----------------------------------------------------------------------------
# 1. Discord user token (this is a self-bot; see the README warning).
DISCORD_TOKEN=

# 2. Any OpenAI-compatible chat endpoint + the model name it serves.
#    A bare host gets "/v1" appended for you; a URL with a path is used as-is.
#    Local Ollama:  http://localhost:11434       + e.g. qwen3:8b
#    OpenRouter:    https://openrouter.ai/api/v1 + moonshotai/kimi-k2.6:free
#    OpenAI:        https://api.openai.com/v1    + gpt-4.1-mini
#    LM Studio:     http://localhost:1234/v1     + whatever you loaded
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Bearer token for that endpoint. Leave blank for a local Ollama.
OLLAMA_API_KEY=

# -----------------------------------------------------------------------------
# Strongly recommended (not required to boot)
# -----------------------------------------------------------------------------
# Your Discord user ID — without it, every admin command is denied to everyone.
# (Discord > Settings > Advanced > Developer Mode, then right-click yourself >
# Copy User ID.)
MAXWELL_OWNER_IDS=
# Dashboard / admin API login. An empty password means the API answers 503.
MAXWELL_ADMIN_USER=admin
MAXWELL_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Telegram connection (optional second transport)
# -----------------------------------------------------------------------------
# Bot token from @BotFather. Setting it auto-starts the Telegram loop unless
# ENABLE_TELEGRAM=false. Telegram is admin-only: the Telegram numeric user id
# must be in MAXWELL_OWNER_IDS or data/admins.json, otherwise the bot logs the
# attempt and stays silent.
TELEGRAM_TOKEN=
# Leave the webhook URL blank for long-polling (the usual setup). Set it to a
# public https base URL to switch to webhook mode instead; the path and the
# X-Telegram-Bot-Api-Secret-Token header are derived from the secrets below.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=8443
TELEGRAM_WEBHOOK_PATH_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# LLM provider — extra knobs (the three required values are at the top)
# -----------------------------------------------------------------------------
# Separate model for the REM dreaming pass. Defaults to OLLAMA_MODEL.
OLLAMA_REM_MODEL=
# Max *output* tokens per completion (not the context window). 8192 is a
# sane default; raise it for long generations, lower it to save cost.
OLLAMA_MAX_TOKENS=8192
OLLAMA_TEMPERATURE=0.7
# Add OpenRouter-style reasoning=exclude on primary calls (true to save cost
# on reasoning models, false if your endpoint rejects the param).
OLLAMA_DISABLE_REASONING=true

# Optional secondary endpoint. Requests rotate primary→fallback→primary
# when this is set. Leave blank to disable.
OLLAMA_FALLBACK_BASE_URL=
OLLAMA_FALLBACK_API_KEY=
OLLAMA_FALLBACK_MODEL=
OLLAMA_FALLBACK_DISABLE_REASONING=true
# Optional vision/omni model for image/video turns. Blank base/key inherit primary.
# Use this when the primary model is text-only (e.g. DeepSeek V4 Flash).
OLLAMA_VISION_BASE_URL=
OLLAMA_VISION_API_KEY=
OLLAMA_VISION_MODEL=
OLLAMA_VISION_DISABLE_REASONING=true
# Total provider attempts per request (1 = no retries, 3 = primary+fallback+primary).
OLLAMA_RETRY_ATTEMPTS=3

# Optional catch-all bearer used as fallback when OLLAMA_API_KEY /
# AUTONOMY_API_KEY are empty. Useful for sharing a single key across
# services in a homelab.
OPENAI_COMPAT_API_KEY=

# Autonomy engine can run on a different endpoint from main chat. Any field
# left blank falls back to the matching OLLAMA_* value.
AUTONOMY_BASE_URL=
AUTONOMY_API_KEY=
AUTONOMY_MODEL=
AUTONOMY_DISABLE_REASONING=false

# Auxiliary background agents (REM, context-cleanup, context-watcher) — the
# "context manager" brains. Any field left blank falls back to the matching
# AUTONOMY_* value (then OLLAMA_*), so a fresh install behaves as before
# (all background agents shared the autonomy endpoint). Set these to run the
# context-manager agents on a different (e.g. cheaper/faster) model than the
# autonomy tick loop. Also settable via the dashboard (aux_* control keys).
AUX_BASE_URL=
AUX_API_KEY=
AUX_MODEL=
AUX_DISABLE_REASONING=true

# -----------------------------------------------------------------------------
# Optional features — true / false / auto  (unset = auto)
#
#   auto  = turn the feature on only if what it needs is actually installed
#   true  = force on (you promise the dependency is there)
#   false = force off — never register the tool or import the dependency
#
# You can leave this entire section alone. It exists so you can override a
# detection result, not because a fresh install needs to fill it in.
# `python3 doctor.py` prints the resolved state of every switch.
# -----------------------------------------------------------------------------
# Vision / multimodal INPUT (forwarding images, video frames, audio to the LLM)
ENABLE_IMAGE_INPUT=auto            # no dependency; on unless you turn it off
ENABLE_VIDEO_INPUT=auto            # needs ffmpeg for frame extraction
ENABLE_AUDIO_INPUT=true            # forward audio (uploads + linked .mp3/.wav/...) to the model

# Tool registration (LLM-facing)
ENABLE_IMAGE_GEN=auto              # image_generator (Pollinations, free) + hd_image (NVIDIA key)
ENABLE_TTS=auto                    # needs espeak-ng, gTTS, or a Fish/NVIDIA key
ENABLE_TTS_VC=auto                 # TTS playback in a voice channel; also needs ffmpeg
ENABLE_EMAIL_TOOLS=auto            # on only when MAXWELL_EMAIL_PASSWORD is set
ENABLE_X=auto                      # x_read/x_post; reading X needs no account (see the X section)
ENABLE_VC=auto                     # needs discord-ext-voice-recv + PyNaCl + libopus
ENABLE_YOUTUBE=auto                # needs the yt-dlp binary
ENABLE_WEB_SEARCH=auto             # needs the ddgs package
ENABLE_FETCH_URL=auto              # no dependency
ENABLE_CREATE_SITE=auto            # needs MAXWELL_SITE_DIR writable
ENABLE_AVATAR=auto                 # change_avatar tool
ENABLE_TELEGRAM=auto               # auto-start Telegram polling/webhook if TELEGRAM_TOKEN is set

# Host access. `shell` runs commands on this machine as the bot user, and the
# sub-agent writes and runs code, so it follows ENABLE_SHELL unless set here.
ENABLE_SHELL=true
ENABLE_SUBAGENT=auto

# RAG vector memory. false = no embedding calls at all; the bot falls back to
# recent-history context and still works.
ENABLE_RAG=auto
RAG_WEB_STORE_ENABLED=true         # auto-embed top web_search results into RAG as kind='web_result'
                                   # so future turns can recall without re-searching. TTL 7d.

# Disable the indirect-prompt-injection gate on shell/sub_agent. When false
# (default), a turn that read fetched URL content or web_search results
# requires an out-of-band `,confirm` from an admin before shell can run.
# When true, shell runs unconditionally. Only enable if you trust the
# model (single-user homelab install).
DISABLE_TAINT_GATE=false

# Background loops. Both spend tokens on their own schedule, so both are
# opt-in. Autonomy also has a dashboard toggle (autonomy_enabled).
ENABLE_REM=false                   # REM dreaming pass (see REM_* below)
ENABLE_AUTONOMY=false              # autonomy engine (see autonomy_* in dashboard / control)

# -----------------------------------------------------------------------------
# RAG embeddings (only used if ENABLE_RAG is on)
# -----------------------------------------------------------------------------
# Defaults target a local Ollama. Any OpenAI-compatible embeddings endpoint
# works — set the base URL to e.g. https://api.openai.com/v1 and match the
# model + dimension. With no embedder reachable the bot logs one line and
# runs without semantic recall.
#   ollama pull qwen3-embedding:0.6b
MAXWELL_EMBED_BASE_URL=http://localhost:11434
MAXWELL_EMBED_MODEL=qwen3-embedding:0.6b
MAXWELL_EMBED_API_KEY=
MAXWELL_EMBED_DIM=1024

# -----------------------------------------------------------------------------
# TTS engine selection (only relevant if ENABLE_TTS=true)
# -----------------------------------------------------------------------------
# local = espeak-ng on the host (no API key, default)
# riva  = NVIDIA Riva TTS (needs NVIDIA_API_KEY, TTS_RIVA_*)
# gtts  = Google Translate TTS (no API key, lower quality, requires outbound HTTPS)
# fish  = Fish Audio REST API (needs FISH_API_KEY). Provider order in TtsTool
#         is Fish → Riva → gTTS, regardless of TTS_ENGINE; TTS_ENGINE only
#         controls the _synthesize_tts_wav path used by voice-channel playback.
# auto  = riva if NVIDIA_API_KEY is set, else local
TTS_ENGINE=auto

TTS_RIVA_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
TTS_RIVA_VOICE=Magpie-Multilingual.EN-US.Jason.Angry
TTS_RIVA_LANGUAGE=en-US

# NVIDIA Riva ASR for live VC (Parakeet CTC). Whisper is too slow here.
# Needs NVIDIA_API_KEY. Same NVCF host as Riva TTS.
ASR_RIVA_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
ASR_RIVA_LANGUAGE=en-US

# Fish Audio TTS — preferred when FISH_API_KEY is set (free tier, supports
# emotion tags like [excited] [laughing] inline). Falls through to Riva then
# gTTS if Fish fails or the key is missing.
# Get a key at https://fish.audio/app/api-keys
FISH_API_KEY=
TTS_FISH_MODEL=s2.1-pro-free
# Default Fish voice (legacy key — used when no named voice is chosen).
TTS_FISH_REFERENCE_ID=8d21b053e2804e2a890e1cf62f267b6f
# Named voices Maxwell can pick between. The `tts` tool accepts
# voice=tiktok|mommy|espanol|spanish; VC replies can use a leading [voice=NAME] tag or the
# vc_tts_voice control. Reference IDs come from the fish.audio voice page
# (the /m/<id>/ path segment).
TTS_FISH_REFERENCE_ID_TIKTOK=
TTS_FISH_REFERENCE_ID_MOMMY=
TTS_FISH_REFERENCE_ID_ESPANOL=
TTS_FISH_FORMAT=mp3

# -----------------------------------------------------------------------------
# Image generation
# -----------------------------------------------------------------------------
# image_generator (pollinations + nvidia flux) needs nothing by default.
POLLINATIONS_MODEL=flux
# image_generator (NVIDIA Flux) needs an NVIDIA NIM key.
NVIDIA_API_KEY=
NVIDIA_IMAGE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-dev
# Unused. The old GPT-Image-2 host dropped every image model; these are kept
# only so an existing .env still loads. hd_image uses GEMINI_IMAGE_* now.
GPT_IMAGE_URL=
GPT_IMAGE_API_KEY=

# -----------------------------------------------------------------------------
# Memory, REM, autonomy (REM_ENABLED above; detailed knobs below)
# -----------------------------------------------------------------------------
DATA_DIR=data
LOGS_DIR=logs
LOG_LEVEL=info
MEMORY_MESSAGE_LIMIT=2000

REM_INTERVAL_SECONDS=600
REM_MAX_TURNS=3
REM_EVENT_BUFFER_MAX=500
REM_RUN_HISTORY=50

# -----------------------------------------------------------------------------
# Discord UX
# -----------------------------------------------------------------------------
# Cooldown for change_avatar tool, in seconds. Default 0 (no local cooldown;
# Discord's own API rate limit still applies, you'll just get a 429 instead
# of a friendly error). Set to 1800 for the old 30-min behaviour.
AVATAR_COOLDOWN_SECONDS=0

# Live tool progress messages. When true, the bot posts one short status
# message per non-terminal tool batch ("shell: checking disk"), edits it
# in place as tools run, and deletes it when the batch ends.
# Can be toggled at runtime with the in-chat command `,progress on|off|status`
# (admin). The env value here is only the initial default; once the
# `,progress` command flips the value it is saved to bot_control.json and
# the panel value wins.
# OFF by default — the sub-agent's plain "working on it" ack covers feedback.
# Set true to enable a live status message per tool batch for every server
# (`,progress off` still silences a noisy server; DMs never get them).
MAXWELL_PROGRESS_MESSAGES=false

# Custom streaming tool-call protocol. Some providers (notably Ollama Cloud's
# minimax-m3) don't stream tool_calls incrementally with native tools= — they
# deliver the whole {name, arguments} block in one final delta, so the bot's
# progress message stays silent for the full generation. When this is on, the
# bot asks the model to emit the tool call as a bare JSON object on its own
# line and parses it from the text stream as it streams. Tool name lands in
# the progress UI at ~12% of stream time vs ~88% for native. Default off.
MAXWELL_CUSTOM_TOOL_CALLS=false

# -----------------------------------------------------------------------------
# Admin API / dashboard
# -----------------------------------------------------------------------------
# MAXWELL_ADMIN_USER / MAXWELL_ADMIN_PASSWORD / MAXWELL_OWNER_IDS are set in
# the block at the top of this file.
# Where the bot looks for its own .env and the site/ directory. Defaults
# point at the repo root so a fresh `git clone` + `cp .env.example .env`
# works without editing paths. Override these for a /opt/maxwell install.
MAXWELL_APP_ROOT=
MAXWELL_ENV_FILE=
MAXWELL_SITE_DIR=
# Public URL where generated sites are served. Used for absolute links in
# the dashboard and Discord embeds. Leave blank to use localhost.
MAXWELL_PUBLIC_BASE_URL=
MAXWELL_CORS_ORIGIN=
MAXWELL_API_HOST=127.0.0.1
MAXWELL_API_PORT=8765

# Discord OAuth on the dashboard. Leave both empty to keep Basic auth only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_ALLOWED_USER_IDS=

# Trust the X-Forwarded-For header from the reverse proxy. Enable ONLY behind
# Caddy/nginx so the dashboard records real client IPs, not 127.0.0.1.
MAXWELL_TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Shell tool (host access)
# -----------------------------------------------------------------------------
# Daily tool-call token budget (0 = no limit). Shell is a security boundary;
# keep MAXWELL_SHELL_FULL_HOST=false unless you really want shell=host shell.
MAXWELL_SHELL_MAX_OUTPUT=100000
MAXWELL_SHELL_MAX_COMMAND_LENGTH=65536
MAXWELL_SHELL_CHANNEL_MAX_CHARS=300
MAXWELL_SHELL_TIMEOUT=600
MAXWELL_SHELL_FULL_HOST=false

# -----------------------------------------------------------------------------
# Email (Postfix + Dovecot on localhost by default)
# -----------------------------------------------------------------------------
# All defaults assume a local MTA / IMAPS server on 127.0.0.1. If you want
# to point the bot at a remote server (e.g. Mailgun's SMTP relay), override
# the host/port and put a real password below. Set ENABLE_EMAIL_TOOLS=false
# to skip the four email tools entirely.
MAXWELL_SMTP_HOST=127.0.0.1
MAXWELL_SMTP_PORT=25
MAXWELL_IMAP_HOST=127.0.0.1
MAXWELL_IMAP_PORT=993
MAXWELL_EMAIL_USER=
MAXWELL_EMAIL_PASSWORD=
MAXWELL_EMAIL_FROM=
MAXWELL_EMAIL_FROM_NAME=Maxwell

# -----------------------------------------------------------------------------
# X / Twitter (only used if ENABLE_X is on)
# -----------------------------------------------------------------------------
# NOTHING HERE IS REQUIRED TO READ X. With this whole section blank he can
# still read any public profile, any post, and (with X_RSS_BASE_URL) search —
# X's own embed backend serves those without an account. What the section
# buys you is the other half: the home timeline, mentions, and posting.
#
# There is no paid API involved. The write credential is two cookies out of a
# browser already logged in as the account you want him to post from:
#   1. log into x.com in a normal browser
#   2. devtools → Application → Cookies → https://x.com
#   3. copy `auth_token` and `ct0` into the two values below
# Treat them exactly like DISCORD_TOKEN: they ARE the account. They expire
# when you log out of that browser session, so re-copy them if x_post starts
# reporting a rejected session. Automating an account this way is against
# X's ToS — same bet as the Discord self-bot this whole project is.
X_AUTH_TOKEN=
X_CT0=
# The handle those cookies belong to, no @. Needed for mentions (both the
# tool and the inbox poller) and used when a post's author comes back blank.
X_HANDLE=
# Backend order. auto = cookies → api → rss → syndication, first that
# answers wins. Pin one (or a comma-separated subset) to debug.
X_BACKEND=auto
# Already run your own X gateway / scraper / free-tier proxy? Point this at
# it and it is tried before the public sources. The default paths are
# /timeline, /tweets?username=, /search?query=, /mentions, /tweet?id=, and
# POST /tweet — override any of them with X_API_PATHS as JSON, e.g.
# {"search": "/v1/search?q={query}&count={limit}"}
X_API_BASE_URL=
X_API_KEY=
X_API_KEY_HEADER=Authorization
X_API_PATHS=
# A Nitter or RSSHub instance for credential-free reading. Public instances
# come and go — leave blank and syndication still covers profiles and posts.
X_RSS_BASE_URL=
X_RSS_PATHS=
# X's embed backend. The one source that needs no configuration at all.
X_SYNDICATION=true
# Post length limit. 280 unless the account has premium (then up to 25000).
X_MAX_CHARS=280
X_TIMEOUT_SECONDS=20
# Where the internal GraphQL query ids live. They rot every few weeks; when
# a call 404s the error says how to refresh them. Blank = data/x_graphql.json
X_GRAPHQL_FILE=

# -----------------------------------------------------------------------------
# Sub-agent (only used if ENABLE_SUBAGENT is on)
# -----------------------------------------------------------------------------
# The sub-agent is Maxwell running on your own provider in a scratch
# directory — no extra binary, no container image. It writes files, runs
# commands, and reports back.
SUBAGENT_BASE_DIR=data/subagents
# Blank = the main OLLAMA_MODEL (the sub-agent runs on the SAME model as the
# main chat). Only set this to run sub-agent work on a cheaper/faster model.
SUBAGENT_MODEL=
# Tool-call steps before it must report back.
SUBAGENT_MAX_STEPS=24
# Wall-clock budget for one sub-agent task, and for a single command it runs.
SUBAGENT_TIMEOUT_SECONDS=900
SUBAGENT_COMMAND_TIMEOUT_SECONDS=120
# Largest file the sub-agent may write, in bytes.
SUBAGENT_MAX_FILE_BYTES=200000
# How many background (fire-and-forget) sub-agents run at once. Each holds a
# provider loop and a sandbox container, so this caps both. Beyond it, runs queue.
SUBAGENT_MAX_CONCURRENT=2
# Hard ceiling on background sub-agents submitted but not yet finished. Past
# this, new background requests are refused ("too busy") instead of piling up.
SUBAGENT_MAX_QUEUED=8

# -----------------------------------------------------------------------------
# YouTube cookies (optional)
# -----------------------------------------------------------------------------
# Path to a Netscape-format cookies.txt for YouTube bot-check workarounds.
# Never commit this file.
YOUTUBE_COOKIES_FILE=

# hd_image — Gemini image model (generate + edit). Blank base/key inherit
# OLLAMA_BASE_URL / OLLAMA_API_KEY, which is where the image model lives.
# Uses /chat/completions, the only route on this gateway that accepts an
# input image (/images/edits ignores `model` and pins the quota-less
# gemini-3-pro-image).
GEMINI_IMAGE_BASE_URL=
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Input images are downscaled to this longest edge before upload — payload
# size dominates latency (629KB input = 89s, same edit at 64KB = 20s).
GEMINI_IMAGE_MAX_INPUT_EDGE=1024
GEMINI_IMAGE_TIMEOUT=300
