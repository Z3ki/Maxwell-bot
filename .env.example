# =============================================================================
# Maxwell — .env template
#
# Copy to .env and provide a Discord bot token and model name; the endpoint
# defaults to localhost. Values in this template are settings applied when
# copied, not necessarily code defaults; explicitly labeled examples differ.
# Optional integrations may require further configuration. `./install.sh` writes this file and runs Maxwell
# in Docker; `docker compose exec maxwell python3 doctor.py` tells you
# what is on, what is off, and why.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the whole minimum install
# -----------------------------------------------------------------------------
# 1. Official Discord bot token from https://discord.com/developers/applications
#    Enable Privileged Gateway Intents: Message Content, Server Members, Presence.
#    User (self-bot) tokens are not supported. DISCORD_TOKEN is a deprecated alias.
DISCORD_BOT_TOKEN=
# DISCORD_TOKEN=
# Development mode defaults to false and requires at least one numeric guild ID.
# MAXWELL_DEV_MODE=false
# MAXWELL_DEV_GUILD_IDS=
# Temporary live tests only: both comma-separated ID lists must match.
LIVE_TEST_WEBHOOK_IDS=
LIVE_TEST_CHANNEL_IDS=

# 2. Any OpenAI-compatible chat endpoint + the model name it serves.
#    A bare host gets "/v1" appended for you; a URL with a path is used as-is.
#    Local Ollama:  http://localhost:11434       + e.g. qwen3:8b
#    Custom API:    https://api.example.com/v1 + your-model-id
#    OpenAI:        https://api.openai.com/v1    + gpt-4.1-mini
#    LM Studio:     http://localhost:1234/v1     + whatever you loaded
AI_BASE_URL=http://localhost:11434
AI_MODEL=
# Optional stronger model for users an operator has marked premium.
# Blank keeps premium on AI_MODEL and only raises their message allowance.
# There is no checkout and no price in the bot.
AI_PREMIUM_MODEL=
# Bearer token for that endpoint. Leave blank for a local Ollama.
AI_API_KEY=
# Legacy input precedence: AI_BASE_URL, AI_API_URL, OLLAMA_BASE_URL use the
# first nonblank value, then http://localhost:11434; AI_MODEL then OLLAMA_MODEL
# use the first nonblank value, otherwise blank (invalid at validation).
# AI_API_KEY, if present even blank, overrides OLLAMA_API_KEY; an empty result
# then falls back to OPENAI_COMPAT_API_KEY. Other listed legacy aliases below
# apply only when their AI_* name is absent, even if the AI_* value is blank.
# OLLAMA_DISABLE_REASONING, OLLAMA_REASONING_EFFORT,
# OLLAMA_FALLBACK_BASE_URL, OLLAMA_FALLBACK_API_KEY, OLLAMA_FALLBACK_MODEL,
# OLLAMA_FALLBACK_DISABLE_REASONING, OLLAMA_FALLBACK_REASONING_EFFORT,
# OLLAMA_VISION_BASE_URL, OLLAMA_VISION_API_KEY, OLLAMA_VISION_MODEL,
# OLLAMA_VISION_DISABLE_REASONING, OLLAMA_RETRY_ATTEMPTS,
# OLLAMA_EMPTY_RESPONSE_RETRIES, and OLLAMA_MAX_TOKENS are deprecated aliases.
# Numeric config.py settings fall back to their code default on invalid input
# (also non-finite floats) and are clamped to their allowed range. Boolean
# settings accept 1/true/yes/on as true; any other supplied value is false.
# Feature switches instead treat unrecognized values like auto.

# -----------------------------------------------------------------------------
# Strongly recommended (not required to boot)
# -----------------------------------------------------------------------------
# Admin allowlist: Discord user IDs that may run admin commands (comma-separated).
# A fresh clone is not owned by anyone until you set the identity fields below.
# (Discord > Settings > Advanced > Developer Mode, then right-click yourself >
# Copy User ID.)
MAXWELL_OWNER_IDS=

# Bot Persona & Ownership
# BOT_NAME is an example display name, not a personal identity.
# Leave CREATOR_* and Discord user IDs empty until you fill in your own.
BOT_NAME=Maxwell
CREATOR_NAME=
CREATOR_ID=
# Chat command prefix. Unset uses ",".
COMMAND_PREFIX=
# Overridable persona birthday (YYYY-MM-DD).
BOT_BIRTHDAY=2026-05-21
# Public invite to advertise, if you have one. Leave empty — do not ship a
# personal Discord invite as the default.
BOT_INVITE_URL=
# OFFICIAL_INVITE is a legacy fallback only when BOT_INVITE_URL is absent;
# setting BOT_INVITE_URL blank suppresses that fallback.
MAXWELL_USER_ID=
# Operator API HTTP Basic credentials. An empty password means the API answers 503.
MAXWELL_ADMIN_USER=admin
MAXWELL_ADMIN_PASSWORD=



# -----------------------------------------------------------------------------
# LLM provider — extra knobs (the three required values are at the top)
# -----------------------------------------------------------------------------
# Max output tokens per completion (not context window). Code default 16384;
# this template deliberately selects 8192 to reduce cost.
AI_MAX_OUTPUT_TOKENS=8192
# Add compatible reasoning=exclude on primary calls (true to save cost
# on reasoning models, false if your endpoint rejects the param).
AI_DISABLE_REASONING=true
# Optional chat-completions reasoning_effort (low/medium/high). Ignored when
# DISABLE_REASONING is true. Used by grok-style endpoints.
AI_REASONING_EFFORT=

# Optional secondary endpoint. Requests rotate primary→fallback→primary
# when this is set. Leave blank to disable.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_DISABLE_REASONING=true
# Optional effort when fallback reasoning stays on (e.g. Muse Spark "minimal").
# Ignored when FALLBACK_DISABLE_REASONING is true.
AI_FALLBACK_REASONING_EFFORT=
# Optional vision/omni model for image/video turns. Blank base/key inherit primary.
# Use this when the primary model is text-only (e.g. DeepSeek V4 Flash).
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_VISION_DISABLE_REASONING=true
# Total provider attempts per request (1 = no retries, 3 = primary+fallback+primary).
AI_RETRY_ATTEMPTS=3
# Extra recovery attempts after every normal attempt returns HTTP 200 with no
# text or tool call. Recovery rotates endpoints and uses non-streaming JSON.
AI_EMPTY_RESPONSE_RETRIES=2
# Provider cooldown is read by providers.py, not Config; default 60 seconds.
# AI_ENDPOINT_COOLDOWN_SECONDS and legacy OLLAMA_ENDPOINT_COOLDOWN_SECONDS
# remain provider settings despite the unused alias-table entry in config.py.

# Optional catch-all bearer used when AI_API_KEY is empty.
OPENAI_COMPAT_API_KEY=





# -----------------------------------------------------------------------------
# Optional features — true / false / auto  (unset = auto)
#
#   auto  = detect where a detector exists; otherwise use the feature default
#   true  = force on (you promise the dependency is there)
#   false = force off
#
# You can leave this entire section alone. It exists so you can override a
# detection result, not because a fresh install needs to fill it in.
# `python3 doctor.py` prints the resolved state of every switch.
# -----------------------------------------------------------------------------
# Vision / multimodal INPUT (forwarding images, video frames, audio to the LLM)
ENABLE_IMAGE_INPUT=auto            # no dependency; on unless you turn it off
ENABLE_VIDEO_INPUT=auto            # needs ffmpeg for frame extraction
ENABLE_AUDIO_INPUT=true            # forward audio (uploads + linked .mp3/.wav/...) to the model

# Tool registration (LLM-facing)
ENABLE_IMAGE_GEN=auto              # image_generator (Gemini text-to-image)
ENABLE_HD_IMAGE=auto               # needs an explicitly configured GEMINI_IMAGE_MODEL
ENABLE_WEB_SEARCH=auto             # needs SearXNG, Tavily, or explicitly enabled ddgs fallback
ENABLE_FETCH_URL=auto              # no dependency
ENABLE_CREATE_SITE=auto            # needs MAXWELL_PUBLIC_BASE_URL; true also permits local hosting
ENABLE_AVATAR=auto                 # change_avatar tool

# Search only runs when the model calls web_search. Provider order:
# configured SearXNG -> configured Tavily -> ddgs only if scraper fallback is enabled.
# Linux host-network deployment: http://127.0.0.1:8888 (base URL, JSON enabled).
# Bridge deployments need an address reachable from the bot container.
SEARXNG_URL=
SEARXNG_TIMEOUT=6                 # seconds before trying the next provider
# Optional Tavily API fallback.
TAVILY_API_KEY=
# Opt in to the keyless ddgs scraper fallback (off by default).
WEB_SEARCH_SCRAPER_FALLBACK=false
# Optional Giphy fallback for GIF phrases that are not a reaction word.
# Reaction GIFs use nekos.best and do not need a key. Never put this key in Discord chat.
GIPHY_API_KEY=
WEB_SEARCH_TIMEOUT=12             # whole search including admission and fallbacks
WEB_SEARCH_MAX_PER_TURN=5         # per-turn search limit; 0 means unlimited
WEB_SEARCH_CONCURRENCY=4          # HTTP searches + separate bounded ddgs workers
WEB_SEARCH_MAX_PENDING=32         # distinct in-flight queries; identical queries share work
WEB_SEARCH_CACHE_SIZE=256         # completed query LRU; 0 disables completed caching
WEB_FETCH_TIMEOUT=12              # source-page deadline, shared with Jina fallback


# Public shell execution is available only through the per-user isolated backend.
ENABLE_SHELL=false                # installer --with-shell enables the backend

# Context uses scoped recent history.

# Disable the indirect-prompt-injection gate on shell. When false
# (default), a turn that read fetched URL content or web_search results
# is refused; a new clean user request is required before shell can run.
# When true, shell runs unconditionally. Only enable if you trust the
# model (single-user homelab install).
DISABLE_TAINT_GATE=false


# -----------------------------------------------------------------------------
# Image generation
# -----------------------------------------------------------------------------
# image_generator and hd_image both use the Gemini image model configured
# further down. image_generator is text-to-image. hd_image also edits.
# NVIDIA_API_KEY and NVIDIA_IMAGE_URL are unused leftovers.
NVIDIA_API_KEY=

# Text to speech. The tts tool speaks a Discord voice message with Mistral
# Voxtral. Emotion is a preset voice (happy, sad, angry, ...), not a tag
# in the text. This replaces Fish Audio.
MISTRAL_API_KEY=
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
NVIDIA_IMAGE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-dev
# Unused. The old GPT-Image-2 host dropped every image model; these are kept
# only so an existing .env still loads. hd_image uses GEMINI_IMAGE_* now.
GPT_IMAGE_URL=
GPT_IMAGE_API_KEY=

# -----------------------------------------------------------------------------
# Conversation history
# -----------------------------------------------------------------------------
DATA_DIR=data
LOGS_DIR=logs
# LOGS is a legacy fallback only when LOGS_DIR is absent (default "logs").
LOG_LEVEL=info
# Structured diagnostics; leave LOG_FILE empty for stdout/stderr only.
LOG_FORMAT=text
LOG_FILE=
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
# Daily operational aggregates and shorter opt-in user membership retention.
USAGE_METRICS_RETENTION_DAYS=90
USAGE_METRICS_ID_RETENTION_DAYS=7
# Host path of this checkout when Maxwell runs in Docker (set by install.sh).
# Needed so the shell sandbox and site-backend containers can bind-mount files.
MAXWELL_HOST_BIND=
# Reply admission and provider connections have no global concurrency cap.
# Legacy MAX_PENDING_REPLY_REQUESTS and ai_concurrency values are ignored.
MEMORY_MESSAGE_LIMIT=2000


# -----------------------------------------------------------------------------
# Discord UX
# -----------------------------------------------------------------------------
# Cooldown for change_avatar tool, in seconds. Default 0 (no local cooldown;
# Discord's own API rate limit still applies, you'll just get a 429 instead
# of a friendly error). Set to 1800 for the old 30-min behaviour.
AVATAR_COOLDOWN_SECONDS=0

# Live tool progress messages. One temporary message lists the tools currently
# running, updates as more tools start, and is deleted when the turn finishes.
# Toggle per server with `/progress arguments:on|off|status`.
# ON by default. Set false to disable the global default; a server can still
# opt in with `/progress arguments:on`.
MAXWELL_PROGRESS_MESSAGES=true

# Custom streaming tool-call protocol. Some providers (notably Ollama Cloud's
# minimax-m3) don't stream tool_calls incrementally with native tools= — they
# deliver the whole {name, arguments} block in one final delta, so the bot's
# progress message stays silent for the full generation. When this is on, the
# bot asks the model to emit the tool call as a bare JSON object on its own
# line and parses it from the text stream as it streams. Tool name lands in
# the progress UI at ~12% of stream time vs ~88% for native. Default off.
MAXWELL_CUSTOM_TOOL_CALLS=false

# -----------------------------------------------------------------------------
# Operator API
# -----------------------------------------------------------------------------
# MAXWELL_ADMIN_USER / MAXWELL_ADMIN_PASSWORD / MAXWELL_OWNER_IDS are set in
# the block at the top of this file.
# config.py loads MAXWELL_ENV_FILE before reading the dotenv file: set it in
# the process environment; default is the .env beside config.py. Dotenv values
# override existing process values. MAXWELL_APP_ROOT is used elsewhere.
MAXWELL_APP_ROOT=
MAXWELL_ENV_FILE=
# Empty or unset site directory resolves to public/bot.
MAXWELL_SITE_DIR=
# Public origin for generated sites, separate from the operator API origin.
# Set this to your real HTTPS origin before publishing generated sites.
# Also supplies /terms/ and /privacy/ links in Maxwell's context when asked;
# host this operator's policy pages there. No automatic first-use legal DMs.
# If SITE_DIR is an absolute path outside this checkout (typical Caddy root
# /var/www/maxwell/bot), docker compose bind-mounts it. Leave it inside the
# checkout (default public/bot) and the .:/app mount already covers it.
MAXWELL_PUBLIC_BASE_URL=
# If absent, CORS origin defaults to MAXWELL_PUBLIC_BASE_URL without trailing
# slashes. Explicit blank (as below) overrides that default.
MAXWELL_CORS_ORIGIN=
MAXWELL_API_HOST=127.0.0.1
MAXWELL_API_PORT=8765

# Optional Discord application ID for bot invite URLs; falls back to the bot ID.
DISCORD_CLIENT_ID=

# Optional user dashboard. Use a dedicated HTTPS hostname, separate from
# MAXWELL_PUBLIC_BASE_URL (generated sites). See docs/DASHBOARD.md.
# Register: https://dashboard.example.com/api/dashboard/callback in Discord OAuth2.
MAXWELL_DASHBOARD_URL=
DISCORD_CLIENT_SECRET=
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
MAXWELL_DASHBOARD_SECRET=

# Trust the X-Forwarded-For header from the reverse proxy. Enable ONLY behind
# Caddy/nginx so the API records real client IPs, not 127.0.0.1.
MAXWELL_TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Shell tool (Linux + Docker + gVisor runsc required)
# -----------------------------------------------------------------------------
# Maxwell refuses shell execution unless Docker has gVisor runsc, the named
# filtered egress network exists, and the host firewall readiness marker is
# mounted read-only. See docs/SHELL_SANDBOX.md before enabling this.
# Shell command text and captured output are complete; the retired
# MAXWELL_SHELL_MAX_OUTPUT / MAXWELL_SHELL_MAX_COMMAND_LENGTH settings are ignored.
MAXWELL_SHELL_TIMEOUT=600
MAXWELL_SHELL_RUNTIME=runsc
MAXWELL_SHELL_NETWORK=maxwell-shell-egress
MAXWELL_SHELL_MAX_CONCURRENCY=4
# At most four tenant workspaces are cached at once (two for one requester).
# Each writable layer is capped at 6 GiB; the host setup requires 30 GiB free.
MAXWELL_SHELL_MAX_CACHED_TENANTS=4
MAXWELL_SHELL_MAX_CACHED_PER_OWNER=2
# Destroy the user's container and workspace after idle expiry. Package and
# workspace files are local to that user and are lost on reset/cancellation.
MAXWELL_SHELL_IDLE_SECONDS=600

# Optional personal bring-your-own-key support. Generate with:
#   openssl rand -hex 32
# Keep this value outside the repository and database. Use
# scripts/rotate_byok_key.py for rotation; changing this value alone makes
# already saved keys unreadable. Empty disables BYOK safely.
MAXWELL_BYOK_ENCRYPTION_KEY=


# hd_image — Gemini image model (generate + edit). Blank base/key inherit
# AI_BASE_URL / AI_API_KEY, which is where the image model lives.
# Uses /chat/completions, the only route on this gateway that accepts an
# input image (/images/edits ignores `model` and pins the quota-less
# gemini-3-pro-image).
GEMINI_IMAGE_BASE_URL=
GEMINI_IMAGE_API_KEY=
# Set a model your provider supports to enable HD images.
# Blank/unset model resolves to gemini-3.1-flash-image, but HD auto-detection
# requires GEMINI_IMAGE_MODEL to be explicitly nonblank.
GEMINI_IMAGE_MODEL=
# Input images are downscaled to this longest edge before upload — payload
# size dominates latency (629KB input = 89s, same edit at 64KB = 20s).
GEMINI_IMAGE_MAX_INPUT_EDGE=1024
GEMINI_IMAGE_TIMEOUT=300


# GitHub Projects. Users log in via Maxwell-generated OAuth links.
# Register an OAuth App (callback: $MAXWELL_PUBLIC_BASE_URL/api/github/oauth/callback).
MAXWELL_GITHUB_OAUTH_CLIENT_ID=
MAXWELL_GITHUB_OAUTH_CLIENT_SECRET=
# Optional admin-only shared identity (identity=bot).
MAXWELL_GITHUB_TOKEN=

# Self-hosted defaults: no hosted-only tool restrictions.
MAXWELL_RESTRICT_PUBLIC_RUNTIME=false

# Seconds to finish in-flight replies after SIGINT/SIGTERM before closing
# Discord. 0 does not wait. Clamped to 0-600. Default 30. Docker's
# stop_grace_period must be longer than this plus supervisor overhead.
DRAIN_TIMEOUT_SECONDS=30
# Leave both unset for Discord's recommended shard count. A manual cluster
# sets SHARD_COUNT and the comma-separated SHARD_IDS this process owns.
# SHARD_IDS without SHARD_COUNT uses max(id)+1.
# SHARD_COUNT=
# SHARD_IDS=

# Optional streamed music: docs/MUSIC.md
# Generate a strong secret; blank means music node is not configured.
LAVALINK_PASSWORD=
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_TLS=false
# YouTube TV account for videos that answer "requires login". Explicitly authorize
# with python3 scripts/youtube_auth.py --env-file .env using a burner account.
# It saves the token privately; then recreate both the audio node and cipher.
# YOUTUBE_OAUTH_REFRESH_TOKEN=
# Shared by the local yt-cipher sidecar and Lavalink. Not a YouTube credential.
# YOUTUBE_CIPHER_PASSWORD=

# Optional Last.fm: docs/MUSIC.md. No callback URL/public server is required.
# Application credentials from https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=
# Independent 32-byte key, e.g. openssl rand -hex 32. Keep its backup: changing
# it does not decrypt existing accounts. Never reuse an API/Discord secret.
LASTFM_ENCRYPTION_KEY=

# Privacy: deployment-owned HTTPS policy URLs. Empty overrides derive from
# MAXWELL_PUBLIC_BASE_URL; never use another operator's policy by default.
MAXWELL_TERMS_URL=
MAXWELL_PRIVACY_URL=
MAXWELL_CONTACT_URL=
MAXWELL_NOTICE_VERSION=processing-notice-3
MAXWELL_HISTORY_RETENTION_DAYS=30
MAXWELL_LOG_RETENTION_DAYS=7
MAXWELL_USAGE_RETENTION_DAYS=7
MAXWELL_CONSENT_RETENTION_DAYS=365
# Operator identity, lawful bases, provider inventory, disk encryption, private
# support, backup expiration/restoration and portal links must be reviewed in
# release-readiness.json before publication. See docs/PRIVACY_AUDIT.md.

# Slow/reasoning models: request budget and whole task budget are independent.
# 0 whole-task timeout uses bot_control.json live_turn_timeout_seconds (900 default).
AI_REQUEST_TIMEOUT_SECONDS=3600
AI_TURN_TIMEOUT_SECONDS=0
# 0 context size keeps the normal prompt budget; otherwise model context in tokens.
AI_CONTEXT_WINDOW=0
# AI_DISABLE_REASONING=false enables the selected model's reasoning capability.
# AI_REASONING_EFFORT=low  # minimal, low, medium, high, xhigh, max (model dependent)

# Custom worker profiles are explicit saved settings, not conversation history.
MAXWELL_AGENT_PROFILE_RETENTION_DAYS=90


# Optional independent Premium subagent provider (OpenAI-compatible).
# Blank model uses personal chat BYOK or the primary AI. User worker BYOK wins.
# Model only: same primary endpoint/key. Explicit base URL: supply its own key;
# never inherit the primary key at a different destination.
# Illustrative non-default settings below: code defaults are blank base/model/
# effort, absent key (None; explicit blank is different), 8192 output tokens,
# 0 context window, reasoning disabled=true, request timeout 600 seconds,
# and turn timeout 0 seconds.
# AI_WORKER_BASE_URL=https://workers.example.com/v1
# AI_WORKER_API_KEY=
# AI_WORKER_MODEL=your-worker-model
# AI_WORKER_MAX_OUTPUT_TOKENS=32768
# AI_WORKER_CONTEXT_WINDOW=256000
# AI_WORKER_DISABLE_REASONING=false
# AI_WORKER_REASONING_EFFORT=high
# AI_WORKER_REQUEST_TIMEOUT_SECONDS=1800
# AI_WORKER_TURN_TIMEOUT_SECONDS=7200

# Worker lifecycle metadata only; task text/transcripts/reports are never saved here.
MAXWELL_TASK_METADATA_RETENTION_DAYS=1
