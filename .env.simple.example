# Maxwell - simple configuration
# Used by easy-install.sh. Advanced options remain in .env.example.

# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Primary AI provider. Edit these three values.
# Ollama:     http://localhost:11434
# LM Studio:  http://localhost:1234/v1
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen3:8b
AI_API_KEY=

# Legacy AI_API_URL and OLLAMA_* inputs remain supported; prefer AI_* above.

# Discord user IDs allowed to use owner/admin commands.
MAXWELL_OWNER_IDS=

BOT_NAME=Maxwell
CREATOR_NAME=
CREATOR_ID=
COMMAND_PREFIX=,

# Operator API HTTP Basic credentials. easy-install.sh generates the password.
MAXWELL_ADMIN_USER=admin
MAXWELL_ADMIN_PASSWORD=

# Optional background features are off by default.
ENABLE_RAG=auto
ENABLE_SHELL=false
MAXWELL_LEGAL_NOTICE=false

# Filled automatically by the installer.
MAXWELL_HOST_BIND=


# Optional independent Premium subagent provider (OpenAI-compatible).
# Blank model uses personal chat BYOK or the primary AI. User worker BYOK wins.
# Model only: same primary endpoint/key. Explicit base URL: supply its own key;
# never inherit the primary key at a different destination.
# AI_WORKER_BASE_URL=https://workers.example.com/v1
# AI_WORKER_API_KEY=
# AI_WORKER_MODEL=your-worker-model
# AI_WORKER_MAX_OUTPUT_TOKENS=8192
# AI_WORKER_CONTEXT_WINDOW=200000
# AI_WORKER_DISABLE_REASONING=false
# AI_WORKER_REASONING_EFFORT=high
# AI_WORKER_REQUEST_TIMEOUT_SECONDS=1800
# AI_WORKER_TURN_TIMEOUT_SECONDS=3600
