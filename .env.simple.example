# Maxwell - simple configuration
# Used by easy-install.sh. Advanced options remain in .env.example.

# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Primary AI provider. Edit these three values.
# Ollama:     http://localhost:11434
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI:     https://api.openai.com/v1
# LM Studio:  http://localhost:1234/v1
AI_API_URL=http://localhost:11434
AI_MODEL=qwen3:8b
AI_API_KEY=

# Compatibility aliases for older Maxwell internals. Leave these alone.
OLLAMA_BASE_URL=${AI_API_URL}
OLLAMA_MODEL=${AI_MODEL}
OLLAMA_API_KEY=${AI_API_KEY}

# Discord user IDs allowed to use owner/admin commands.
MAXWELL_OWNER_IDS=

BOT_NAME=Maxwell
CREATOR_NAME=
CREATOR_ID=
COMMAND_PREFIX=,

# Dashboard login. easy-install.sh generates the password.
MAXWELL_ADMIN_USER=admin
MAXWELL_ADMIN_PASSWORD=

# Optional background features are off by default.
ENABLE_AUTONOMY=false
ENABLE_REM=false
REM_ENABLED=false
ENABLE_RAG=auto

# Filled automatically by the installer.
MAXWELL_HOST_BIND=
