# Maxwell - simple configuration
# Used by easy-install.sh. Advanced options remain in .env.example.

# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=
# Temporary live tests only: both comma-separated ID lists must match.
LIVE_TEST_WEBHOOK_IDS=
LIVE_TEST_CHANNEL_IDS=

# Primary AI provider. Edit these three values. qwen3:8b is illustrative;
# config.py defaults AI_MODEL to blank and requires a model at validation.
# Ollama:     http://localhost:11434
# LM Studio:  http://localhost:1234/v1
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen3:8b
AI_API_KEY=

# config.py defaults AI_BASE_URL to http://localhost:11434 and the key to blank.
# Legacy AI_API_URL and OLLAMA_* inputs remain supported; see .env.example for
# precedence, the complete config.py variable inventory and code defaults.

# Discord user IDs allowed to use owner/admin commands.
MAXWELL_OWNER_IDS=

BOT_NAME=Maxwell
CREATOR_NAME=
CREATOR_ID=
COMMAND_PREFIX=,

# Operator API HTTP Basic credentials. easy-install.sh generates the password.
MAXWELL_ADMIN_USER=admin
MAXWELL_ADMIN_PASSWORD=

# Optional diagnostic file and operational metrics retention.
LOG_LEVEL=info
LOG_FORMAT=text
LOG_FILE=
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
USAGE_METRICS_RETENTION_DAYS=90
USAGE_METRICS_ID_RETENTION_DAYS=7

# Shell is off by default. Other ENABLE_* switches may default on or auto-detect.
ENABLE_SHELL=false
# The retired MAXWELL_LEGAL_NOTICE setting is ignored.

# Filled automatically by the installer.
MAXWELL_HOST_BIND=


# Optional independent Premium subagent provider (OpenAI-compatible).
# Blank model uses personal chat BYOK or the primary AI. User worker BYOK wins.
# Model only: same primary endpoint/key. Explicit base URL: supply its own key;
# never inherit the primary key at a different destination.
# Illustrative values, not defaults: worker output tokens default to 8192,
# context window and turn timeout to 0, request timeout to 600, reasoning
# disabled to true, and base URL, model and effort to blank. An absent key
# permits inheritance; an explicitly blank key is distinct.
# AI_WORKER_BASE_URL=https://workers.example.com/v1
# AI_WORKER_API_KEY=
# AI_WORKER_MODEL=your-worker-model
# AI_WORKER_MAX_OUTPUT_TOKENS=8192
# AI_WORKER_CONTEXT_WINDOW=200000
# AI_WORKER_DISABLE_REASONING=false
# AI_WORKER_REASONING_EFFORT=high
# AI_WORKER_REQUEST_TIMEOUT_SECONDS=1800
# AI_WORKER_TURN_TIMEOUT_SECONDS=7200
