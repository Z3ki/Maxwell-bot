# Copy to .env.dev in the isolated Dev checkout; keep chmod 600 and out of Git.
DISCORD_BOT_TOKEN=
MAXWELL_DEV_GUILD_IDS=
MAXWELL_DEV_MODE=true

# Reuse only explicitly authorized primary/fallback AI endpoint, model, and key
# settings from Production. Do not copy its entire .env, Discord token, guild
# settings, music credentials, or data paths. Remote AI needs no local container.
# Host-local endpoints must use host.docker.internal, not localhost, from Dev.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2048
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_DISABLE_REASONING=true
AI_FALLBACK_REASONING_EFFORT=

# Optional local model: enable Compose's local-ai profile, then set AI_BASE_URL
# to http://ollama-dev:11434 and AI_MODEL to a model pulled into dev_models
# (for example qwen2.5:1.5b). Leave AI_API_KEY blank for local Ollama.

# Optional music: use docker-compose.dev.music.yml with --env-file .env.dev.
# Generate two distinct random secrets for Dev; never reuse Production's values.
# Both passwords are required by the overlay and have no default.
LAVALINK_PASSWORD=
YOUTUBE_CIPHER_PASSWORD=
# Authorize a separate burner account with make youtubeauthdev; no token in chat.
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Optional Last.fm: application credentials may be reused only with permission;
# Dev and Production then share the application's upstream rate quota.
# Account databases remain separate; generate a NEW Dev encryption key.
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_ENCRYPTION_KEY=

ENABLE_SHELL=false
ENABLE_CREATE_SITE=false
ENABLE_IMAGE_GEN=false
