# Copy to .env.dev in the isolated Dev checkout; keep chmod 600 and out of Git.
DISCORD_BOT_TOKEN=
MAXWELL_DEV_GUILD_IDS=
MAXWELL_DEV_MODE=true

# The Dev Compose project runs a small local model on its own volume.
# A separately authorized Dev API may replace it later.
OLLAMA_BASE_URL=http://ollama-dev:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_API_KEY=
OLLAMA_MAX_TOKENS=2048

ENABLE_TELEGRAM=false
ENABLE_AUTONOMY=false
ENABLE_EMAIL_TOOLS=false
ENABLE_SHELL=false
ENABLE_CREATE_SITE=false
ENABLE_IMAGE_GEN=false
ENABLE_VC=false
REM_ENABLED=false
