# Set MAXWELL_PUBLIC_BASE_URL=https://maxwell.example.com in .env.
# Keep the authenticated operator API on a separate origin from generated sites.
# The operator API and user settings dashboard have separate origins.
# Replace all example hosts; set MAXWELL_DASHBOARD_URL=https://dashboard.maxwell.example.com.
dashboard.maxwell.example.com {
	header X-Frame-Options "DENY"
	header X-Content-Type-Options "nosniff"
	@settings path /dashboard /dashboard/* /api/dashboard/*
	handle @settings {
		reverse_proxy 127.0.0.1:8765
	}
	handle / {
		redir /dashboard/ 302
	}
	handle {
		respond "Not found" 404
	}
}

admin.maxwell.example.com {
	header X-Frame-Options "DENY"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"

	handle /api/* {
		reverse_proxy 127.0.0.1:8765
	}
	handle /data/* {
		reverse_proxy 127.0.0.1:8765
	}
	handle {
		respond "Not found" 404
	}
}

maxwell.example.com {
	@dashboard_link path /dashboard /dashboard/*
	redir @dashboard_link https://dashboard.maxwell.example.com/dashboard/ 302
	root * /var/www/maxwell/bot
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"

	# Copy web/ contents into /var/www/maxwell. Expose only the landing and
	# policy/support pages and their assets here; operator controls stay on the
	# separate API origin. Do not expose the entire web/ directory.
	@public_pages path / /index.html /terms /terms/* /privacy /privacy/* /guide /guide/* /contact /contact/* /assets/*
	handle @public_pages {
		root * /var/www/maxwell
		file_server
	}

	# Caddy path globs do not cover arbitrarily nested API endpoint segments.
	# Match the exact API root plus all descendants, before static files.
	@site_api path_regexp site_api ^/bot/[a-z0-9-]{2,30}/api(?:/.*)?$
	handle @site_api {
		reverse_proxy 127.0.0.1:8765
	}
	handle_path /bot/* {
		file_server
	}
	# Public endpoints the generated pages and GitHub integration use. These
	# are unauthenticated by design (KV is openly writable; OAuth/webhook
	# verify their own tokens). Keep the operator API on its separate origin.
	@public_api path /api/site/* /api/github/webhook /api/github/oauth/*
	handle @public_api {
		reverse_proxy 127.0.0.1:8765
	}
	# Premium public storage links.
	handle /u/* {
		reverse_proxy 127.0.0.1:8765
	}
	# Never expose /admin, the operator API, or /data on the site origin.
	handle {
		respond "Not found" 404
	}
}
