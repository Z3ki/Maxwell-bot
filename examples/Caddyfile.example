# Set MAXWELL_PUBLIC_BASE_URL=https://maxwell.example.com and
# DISCORD_REDIRECT_BASE=https://admin.maxwell.example.com in .env.
# Do not serve generated JavaScript on the dashboard origin: dashboard
# credentials are stored in origin-scoped browser storage.
admin.maxwell.example.com {
	root * /var/www/maxwell
	header X-Frame-Options "DENY"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"

	handle /api/* {
		reverse_proxy 127.0.0.1:8765
	}
	handle /data/* {
		reverse_proxy 127.0.0.1:8765
	}
	@admin path /admin /admin/*
	handle @admin {
		file_server
	}
	# Discord Custom Install Link. Register https://admin.maxwell.example.com/install
	# in the Developer Portal (Installation → Install Link → Custom URL).
	@install path /install /install/*
	handle @install {
		file_server
	}
	handle {
		respond "Not found" 404
	}
}

maxwell.example.com {
	root * /var/www/maxwell/bot
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"

	# Site backends are public and must precede the static file handler.
	handle /bot/*/api/* {
		reverse_proxy 127.0.0.1:8765
	}
	handle_path /bot/* {
		file_server
	}
	# Never expose /admin, /api, or /data on the generated-site origin.
	handle {
		respond "Not found" 404
	}
}
