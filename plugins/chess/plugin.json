{
  "id": "chess",
  "name": "Chess",
  "version": "1.0.0",
  "description": "Play chess against Maxwell in a channel.",
  "author": "Maxwell",
  "api_version": 1,
  "bundled": true,
  "enabled_globally": true,
  "enabled_by_default": true,
  "protected": false,
  "uninstallable": true,
  "permissions": [],
  "optional_dependencies": [
    "chess"
  ],
  "platforms": [
    "discord"
  ],
  "tools": [
    {
      "name": "chess_start",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "chess_move",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "chess_state",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "chess_resign",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    }
  ],
  "prompt": {
    "position": "tools",
    "priority": 80,
    "requires_tools": [
      "chess_start",
      "chess_move",
      "chess_state",
      "chess_resign"
    ],
    "text": "chess: you play your own moves. Tools return text-only FEN and legal moves annotated with tactical value; boards are shown in Discord only. Read the position, pick strongest, pass as move=. Use chess_state to re-sync; no image inspection needed. Nothing plays for you. Play to win."
  }
}
