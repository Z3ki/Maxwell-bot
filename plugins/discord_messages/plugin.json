{
  "id": "discord_messages",
  "name": "Discord Messaging",
  "version": "1.0.0",
  "description": "Send, edit, react, pin, poll, and otherwise talk in Discord.",
  "author": "Maxwell",
  "api_version": 1,
  "bundled": true,
  "enabled_globally": true,
  "enabled_by_default": true,
  "protected": true,
  "uninstallable": false,
  "permissions": [
    "messages.send",
    "messages.read"
  ],
  "optional_dependencies": [],
  "platforms": [
    "discord",
    "telegram"
  ],
  "tools": [
    {
      "name": "react",
      "returns_result": false,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "edit_message",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "delete_message",
      "returns_result": false,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "create_poll",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "forward_message",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "typing",
      "returns_result": false,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "send_message",
      "returns_result": false,
      "ends_turn": true,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "send_file",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "pin_message",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "purge_messages",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "search_messages",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "create_invite",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "bot_invite_url",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "no_response",
      "returns_result": false,
      "ends_turn": true,
      "is_destructive": false,
      "requires_admin": false
    }
  ],
  "prompt": {
    "position": "tools",
    "priority": 80,
    "requires_tools": ["bot_invite_url"],
    "text": "ADD THIS BOT: when someone asks how to add Maxwell / this bot, add as app, add to my apps, or add to a server, call bot_invite_url then send_message the matching link. kind=app or kind=server if they only want one; default both. Do not invent a URL. This is not create_invite (that makes a discord.gg for the current server)."
  }
}
