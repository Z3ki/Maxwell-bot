{
  "name": "maxwell_extras",
  "version": "1.4.0",
  "description": "Conversational settings, private configuration forms, rich Discord UI, reminders and media inspection.",
  "enabled_globally": true,
  "allowed_users": [],
  "denied_users": [],
  "id": "maxwell_extras",
  "api_version": 1,
  "author": "Maxwell",
  "bundled": true,
  "enabled_by_default": true,
  "permissions": [
    "messages.send"
  ],
  "tools": [
    {
      "name": "reminder",
      "returns_result": true
    },
    {
      "name": "send_rich_message",
      "returns_result": false
    },
    {
      "name": "inspect_media_url",
      "returns_result": true
    },
    {
      "name": "get_maxwell_updates",
      "returns_result": true
    },
    {
      "name": "get_configuration",
      "returns_result": true,
      "ends_turn": false,
      "requires_admin": false,
      "is_destructive": false
    },
    {
      "name": "configure",
      "returns_result": true,
      "ends_turn": false,
      "requires_admin": false,
      "is_destructive": true
    },
    {
      "name": "open_configuration",
      "returns_result": true,
      "ends_turn": false,
      "requires_admin": false,
      "is_destructive": false
    }
  ]
}
