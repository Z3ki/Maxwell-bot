{
  "name": "maxwell_extras",
  "version": "1.2.2",
  "description": "Rich Discord UI, persistent reminders, media inspection, and tool-call disclosure.",
  "enabled_globally": true,
  "allowed_users": [],
  "denied_users": [],
  "id": "maxwell_extras",
  "api_version": 1,
  "author": "Maxwell",
  "bundled": true,
  "enabled_by_default": true,
  "permissions": [
    "messages.send",
    "memory.read"
  ],
  "tools": [
    {
      "name": "reminder",
      "returns_result": true
    },
    {
      "name": "send_rich_message",
      "returns_result": false
    },
    {
      "name": "recall_cross_server_memory",
      "returns_result": true
    },
    {
      "name": "inspect_media_url",
      "returns_result": true
    }
  ]
}
