      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "send_meme",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "send_media",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    }
  ]
