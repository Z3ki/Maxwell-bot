{
  "id": "personality",
  "name": "Personality and Server Prompts",
  "version": "1.0.0",
  "description": "Owner-editable personality and per-server instructions.",
  "author": "Maxwell",
  "api_version": 1,
  "bundled": true,
  "enabled_globally": true,
  "enabled_by_default": true,
  "protected": false,
  "uninstallable": true,
  "permissions": [
    "config.modify"
  ],
  "optional_dependencies": [],
  "platforms": [
    "discord"
  ],
  "tools": [
    {
      "name": "update_base_personality",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": true,
      "requires_admin": true
    },
    {
      "name": "update_server_prompt",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": true,
      "requires_admin": true
    }
  ]
}
