{
  "id": "sites",
  "name": "Generated Sites",
  "version": "1.0.0",
  "description": "Create, edit, host, and list generated websites.",
  "author": "Maxwell",
  "api_version": 1,
  "bundled": true,
  "enabled_globally": true,
  "enabled_by_default": true,
  "protected": false,
  "uninstallable": true,
  "permissions": [
    "files.write",
    "network"
  ],
  "optional_dependencies": [],
  "platforms": [
    "discord"
  ],
  "tools": [
    {
      "name": "create_site",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "edit_site",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "delete_site",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "list_sites",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    },
    {
      "name": "host_file",
      "returns_result": true,
      "ends_turn": false,
      "is_destructive": false,
      "requires_admin": false
    }
  ],
  "prompt": {
    "position": "tools",
    "priority": 80,
    "requires_tools": [
      "create_site",
      "edit_site",
      "delete_site",
      "list_sites",
      "host_file"
    ],
    "text": "create_site publishes static HTML/CSS/JS. The optional backend=true flag enables only the simple KV API. Do not claim a custom backend server is available. Never paste site source into chat or claim an unfinished page works."
  }
}
